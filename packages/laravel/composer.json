{
    "name": "nabux/nabugate-laravel",
    "description": "Official Laravel SDK & Filament integration for NabuGate AI & Voice Gateway",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "NabuX Team",
            "email": "support@nabuxai.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "NabuGate\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NabuGate\\NabuGateServiceProvider"
            ],
            "aliases": {
                "NabuGate": "NabuGate\\Facades\\NabuGate"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
