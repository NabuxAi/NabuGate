# Internal reverse proxy for the Coolify / Traefik deployment.
#
# A template: the nginx image renders it at start, filling ${UPSTREAM_HOST}
# (the product's own host, e.g. gate.nabuxai.com) and ${MIRROR_HOST} (the
# name browsers in Iran open, e.g. gate.nabuxai.ir) from the environment.
# Only variables set in the environment are replaced, so nginx's own
# $host, $scheme and the like pass through untouched.
#
# coolify-proxy owns ports 80 and 443 and the Let's Encrypt certificate.
# This process only listens on port 80 inside the container. Traefik talks
# to it over plain HTTP, so $scheme here is http even though the browser
# used https. The headers below are therefore literals, not $host / $scheme:
# the upstream Host and SNI stay the upstream's (that is the certificate the
# foreign server presents), and the product learns the browser's host from
# X-Forwarded-Host.
#
# This is the rewrite mode, for a product that pins its public URL at build
# time (NabuChat bakes NEXT_PUBLIC_DASHBOARD_URL into its JavaScript). Without
# it the pages load from the mirror and then every link, API call and
# sign-in redirect goes straight back to the upstream host — the one a
# browser in Iran was supposed to avoid. So https://${UPSTREAM_HOST} becomes
# https://${MIRROR_HOST} in pages, scripts, styles, JSON, redirects and
# cookies. The upstream is asked for uncompressed bodies, since nginx cannot
# rewrite inside gzip; the mirror's Traefik compresses on the way out.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # IPv4 only. A container with IPv6 disabled refuses to start on [::]:80.
    listen 80 default_server;
    server_name _;

    # Audio uploads (transcription) are the large bodies. 100m covers a long
    # recording without accepting an unbounded request. Traefik does not
    # apply a smaller limit of its own.
    client_max_body_size 100m;

    # SSE and streamed chat must leave as the upstream writes them. gzip
    # here would collect a stream into one body. Traefik's own compress
    # middleware has to be off too; see README.
    gzip off;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    proxy_max_temp_file_size 0;

    proxy_http_version 1.1;
    proxy_connect_timeout 10s;
    proxy_send_timeout 3600s;
    proxy_read_timeout 3600s;
    send_timeout 3600s;

    # Coolify's healthcheck hits this directly. It does not call the upstream,
    # so a blip at gate.nabuxai.com does not restart the container.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        # Resolve on each request through Docker's DNS. A startup lookup would
        # pin one address for the life of the process.
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $upstream_host ${UPSTREAM_HOST};
        proxy_pass https://$upstream_host;
        proxy_ssl_server_name on;
        proxy_ssl_name ${UPSTREAM_HOST};

        # Upstream vhost and certificate. Not the mirror's name.
        proxy_set_header Host ${UPSTREAM_HOST};

        # What the browser actually opened. Hard-coded because this hop is
        # HTTP behind Traefik: $host may be rewritten and $scheme is http.
        proxy_set_header X-Forwarded-Host ${MIRROR_HOST};
        proxy_set_header X-Forwarded-Proto https;

        # Traefik is the edge, so the browser address is already the first
        # entry. $remote_addr here is Traefik; appending keeps the browser
        # first (the gateway rate-limits that hop) and records this proxy
        # after it. Do not replace the header with $remote_addr.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Plain bodies from the upstream, so they can be rewritten.
        proxy_set_header Accept-Encoding "";

        sub_filter_once off;
        sub_filter_types text/html text/css text/javascript application/javascript application/json application/manifest+json;
        sub_filter 'https://${UPSTREAM_HOST}' 'https://${MIRROR_HOST}';
        sub_filter 'https:\/\/${UPSTREAM_HOST}' 'https:\/\/${MIRROR_HOST}';
        # URL-encoded copies are left alone on purpose: they are OAuth
        # redirect_uri values, and the product exchanges the code with the
        # upstream URL it was built with. Rewriting only the authorize step
        # makes the provider refuse the exchange, so sign-in round-trips
        # through the upstream host until the product derives its origin
        # per request.

        proxy_redirect https://${UPSTREAM_HOST}/ https://${MIRROR_HOST}/;
        proxy_cookie_domain ${UPSTREAM_HOST} ${MIRROR_HOST};

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
